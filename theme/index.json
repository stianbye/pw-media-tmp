nt-size:12px;letter-spacing:.14em;text-transform:uppercase;font-weight:600;text-shadow:0 1px 8px rgba(0,0,0,.6)}.pw-tik{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.pw-tik .pw-cell img{aspect-ratio:9/16;height:auto}@media(max-width:820px){.pw-grid,.pw-tik{grid-template-columns:1fr 1fr}.pw-cell img{height:300px}}</style><div class=\"pw\"><div class=\"pw-head\"><div class=\"pw-ey\">Fra banen til byen</div><h2 class=\"pw-t\">Én caps, hele uka</h2></div><div class=\"pw-grid\"><div class=\"pw-cell\"><img src=\"https://raw.githubusercontent.com/stianbye/pw-media-tmp/main/img/gal_group.jpg\" alt=\"Venner med Slicer-caps på golfbanen\" loading=\"lazy\"><span class=\"pw-cap\">Banen</span></div><div class=\"pw-cell\"><img src=\"https://raw.githubusercontent.com/stianbye/pw-media-tmp/main/img/gal_street.jpg\" alt=\"Streetwear med Bunker Slicer\" loading=\"lazy\"><span class=\"pw-cap\">Street</span></div><div class=\"pw-cell\"><img src=\"https://raw.githubusercontent.com/stianbye/pw-media-tmp/main/img/gal_rooftop.jpg\" alt=\"Rooftop med Bunker Slicer\" loading=\"lazy\"><span class=\"pw-cap\">Off duty</span></div><div class=\"pw-cell\"><img src=\"https://raw.githubusercontent.com/stianbye/pw-media-tmp/main/img/gal_fashion.jpg\" alt=\"Midnight Slicer fashion\" loading=\"lazy\"><span class=\"pw-cap\">Statement</span></div></div><div class=\"pw-head\"><div class=\"pw-ey\">@parteewear</div><h2 class=\"pw-t\">Som sett på TikTok</h2></div><div class=\"pw-tik\"><div class=\"pw-cell\"><img src=\"https://raw.githubusercontent.com/stianbye/pw-media-tmp/main/img/tik_1.jpg\" alt=\"Forest Slicer TikTok\" loading=\"lazy\"></div><div class=\"pw-cell\"><img src=\"https://raw.githubusercontent.com/stianbye/pw-media-tmp/main/img/tik_2.jpg\" alt=\"Bunker Slicer TikTok\" loading=\"lazy\"></div><div class=\"pw-cell\"><img src=\"https://raw.githubusercontent.com/stianbye/pw-media-tmp/main/img/tik_3.jpg\" alt=\"Midnight Slicer TikTok\" loading=\"lazy\"></div><div class=\"pw-cell\"><img src=\"https://raw.githubusercontent.com/stianbye/pw-media-tmp/main/img/tik_4.jpg\" alt=\"Midnight Slicer TikTok\" loading=\"lazy\"></div></div></div>", "color_scheme": "scheme-1", "section_width": "full-width", "padding-block-start": 48, "padding-block-end": 48}}, "media_with_content_AxL3Ej": {"type": "media-with-content", "blocks": {"media": {"type": "_media-without-appearance", "static": true, "settings": {"media_type": "image", "image": "shopify://shop_images/story_urban_v2.jpg"}, "blocks": {}}, "content": {"type": "_content-without-appearance", "static": true, "settings": {"gap": 24}, "blocks": {"cap": {"type": "text", "settings": {"text": "<p>Inspirasjon</p>", "type_preset": "h6", "case": "uppercase"}, "blocks": {}}, "grp": {"type": "group", "settings": {"gap": 12}, "blocks": {"h": {"type": "text", "settings": {"text": "<h2>The Slicer</h2>", "type_preset": "h3", "max_width": "normal"}, "blocks": {}}, "b": {"type": "text", "settings": {"text": "<p>Vi opprettet denne kolleksjonen fordi vi ville noe helt annet enn normalen. Golfinsipirert, men ikke som alt du ser på banen.<br/><br/>Alle bruker de samme logoene, de samme merkene, den samme stilen. Vi tenkte: hvorfor ikke lage noe som faktisk føles personlig?<br/><br/>\"The Slicer\" handler om å ta golf litt mindre seriøst. Det er mange slicere der ute...noen innrømmer det, mens andre velger å slå ut med jerna. Vi valgte å eie det!<br/><br/>Husk at hvis du ikke slicer selv, spiller du garantert med noen som gjør det. Dette er bare starten på eventyret.</p>", "type_preset": "rte", "max_width": "narrow"}, "blocks": {}}}, "block_order": ["h", "b"]}, "btn": {"type": "button", "settings": {"label": "Om oss", "link": "shopify://pages/about-us-1", "style_class": "button"}, "blocks": {}}}, "block_order": ["cap", "grp", "btn"]}}, "settings": {"media_position": "left", "section_width": "full-width", "extend_media": true, "color_scheme": "scheme-4"}}, "features_pw1": {"type": "media-with-content", "blocks": {"media": {"type": "